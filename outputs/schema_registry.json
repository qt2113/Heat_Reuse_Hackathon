{
  "pipeline": [
    "features",
    "A: hourly heat simulation",
    "B: cost, carbon, value",
    "C: constraints + MCDA"
  ],
  "dimensions": [
    "Technical",
    "Economic + Delivery",
    "Environmental",
    "Social + Regenerative"
  ],
  "kpis": {
    "T1": {
      "dimension": "Technical",
      "model": "A",
      "name": "Recoverable heat",
      "unit": "GWh/yr",
      "model_a_inputs": [
        "T1_recoverable_heat_GWh"
      ]
    },
    "T2": {
      "dimension": "Technical",
      "model": "A",
      "name": "Seasonal heat-pump COP",
      "unit": "-",
      "model_a_inputs": [
        "T2_SCOP"
      ]
    },
    "T4": {
      "dimension": "Technical",
      "model": "A",
      "name": "Hourly demand coverage",
      "unit": "%",
      "model_a_inputs": [
        "T4_coverage_pct"
      ]
    },
    "T7": {
      "dimension": "Technical",
      "model": "A",
      "name": "Network route length",
      "unit": "m",
      "model_a_inputs": [
        "T7_route_m"
      ]
    },
    "C1": {
      "dimension": "Economic + Delivery",
      "model": "B",
      "name": "CAPEX per kW",
      "unit": "$/kWth",
      "model_a_inputs": [
        "HP_cap_MW",
        "HX_cap_MW",
        "tank_MWh",
        "route_m",
        "apartments_connected"
      ]
    },
    "C2": {
      "dimension": "Economic + Delivery",
      "model": "B",
      "name": "Levelised cost of heat",
      "unit": "$/MWh",
      "model_a_inputs": [
        "Q_network_MWh",
        "E_network_MWh",
        "Q_DC_used_MWh",
        "backup_fuel_*",
        "HP_cap_MW"
      ]
    },
    "C3": {
      "dimension": "Economic + Delivery",
      "model": "B",
      "name": "Saving vs current heat cost",
      "unit": "%",
      "model_a_inputs": [
        "a_annual_building: Q_network_MWh, baseline_fuel_MWh, main_fuel"
      ]
    },
    "N1": {
      "dimension": "Environmental",
      "model": "B",
      "name": "Energy Reuse Factor",
      "unit": "%",
      "model_a_inputs": [
        "Q_DC_used_MWh",
        "E_IT_MWh"
      ]
    },
    "N2": {
      "dimension": "Environmental",
      "model": "B",
      "name": "Net GHG avoided",
      "unit": "tCO2e/yr",
      "model_a_inputs": [
        "fuel_displaced_*",
        "backup_fuel_*",
        "E_network_MWh",
        "E_src_MWh"
      ]
    },
    "N4": {
      "dimension": "Environmental",
      "model": "B",
      "name": "On-site combustion displaced",
      "unit": "MWh/yr, kg NOx",
      "model_a_inputs": [
        "fuel_displaced_gas_MWh"
      ]
    },
    "N6": {
      "dimension": "Environmental",
      "model": "B",
      "name": "Winter peak vs all-electric ASHP",
      "unit": "MW",
      "model_a_inputs": [
        "P_at_design_hour_MW",
        "D_peak_design_MW"
      ]
    },
    "S1": {
      "dimension": "Social + Regenerative",
      "model": "B",
      "name": "Low-income households served",
      "unit": "households",
      "model_a_inputs": [
        "nycha_apartments_connected",
        "a_annual_building: units, is_nycha"
      ]
    },
    "S3": {
      "dimension": "Social + Regenerative",
      "model": "B",
      "name": "EJ exposure of served block",
      "unit": "index",
      "model_a_inputs": [
        "a_annual_building: property_id (joined to dac_tracts_1km)"
      ]
    },
    "S5": {
      "dimension": "Social + Regenerative",
      "model": "B",
      "name": "Acceptance & governance (rubric)",
      "unit": "0-4",
      "model_a_inputs": [
        "scenario"
      ]
    },
    "S6": {
      "dimension": "Social + Regenerative",
      "model": "B",
      "name": "Rebuild design-window fit (rubric)",
      "unit": "0-2",
      "model_a_inputs": [
        "scenario"
      ]
    },
    "S7": {
      "dimension": "Social + Regenerative",
      "model": "B",
      "name": "Net value to the data center",
      "unit": "$/yr",
      "model_a_inputs": [
        "Q_DC_used_MWh",
        "E_src_MWh"
      ]
    }
  },
  "constraints": {
    "H1": "A",
    "H2": "A",
    "H3": "A",
    "H4": "A",
    "H5": "A",
    "H6": "B",
    "H7": "A"
  },
  "tables": {
    "model_a/a_runs.csv": {
      "producer": "A",
      "status": "implemented",
      "consumers": [
        "B",
        "C",
        "frontend"
      ],
      "key": [
        "run_id"
      ],
      "description": "One row per run: scenario x design x assumption set, with every resolved parameter."
    },
    "model_a/a_annual_system.csv": {
      "producer": "A",
      "status": "implemented",
      "consumers": [
        "B",
        "C",
        "frontend page 2"
      ],
      "key": [
        "run_id"
      ],
      "description": "Annual physical totals per run (MWh, MW), sizing, COPs, technical indicators T1/T2/T4/T7 (not scored)."
    },
    "model_a/a_annual_building.csv": {
      "producer": "A",
      "status": "implemented",
      "consumers": [
        "B (bills, carbon, equity)",
        "frontend page 1"
      ],
      "key": [
        "run_id",
        "property_id"
      ],
      "description": "Per connected building: useful demand, heat from network, backup heat/fuel, fuel displaced, baseline fuel, HP electricity."
    },
    "model_a/a_monthly.csv": {
      "producer": "A",
      "status": "implemented",
      "consumers": [
        "frontend page 2"
      ],
      "key": [
        "run_id",
        "month"
      ],
      "description": "Monthly demand, network heat, backup, electricity, data-center heat used."
    },
    "model_a/a_constraints.csv": {
      "producer": "A",
      "status": "implemented",
      "consumers": [
        "C (feasibility gate)"
      ],
      "key": [
        "run_id",
        "constraint_id"
      ],
      "description": "H1-H5, H7 pass/fail with metric; H6 marked pending_model_B."
    },
    "model_a/hourly/<run_id>.csv.gz": {
      "producer": "A",
      "status": "implemented",
      "consumers": [
        "frontend page 2",
        "B (peak, time-of-use)"
      ],
      "key": [
        "run_id",
        "hour_of_year"
      ],
      "description": "8,760-hour series for reference-design base runs."
    },
    "model_a/a_operating_modes.csv": {
      "producer": "A",
      "status": "implemented",
      "consumers": [
        "C (evaluation report)",
        "frontend page 2"
      ],
      "key": [
        "scenario",
        "mode"
      ],
      "description": "Stress tests: normal year, DC outage 72 h, heat-pump maintenance, network outage 72 h, summer; unserved heat, backup peak, share of DC heat still rejected by towers."
    },
    "config/delivery_governance.csv": {
      "producer": "team (evidence register)",
      "status": "implemented",
      "consumers": [
        "B (b_delivery_assessment)",
        "C (evaluation report)",
        "frontend page 3"
      ],
      "key": [
        "item_id"
      ],
      "description": "Unscored structured assessment: revenue/connection model, ownership, responsibilities, risk allocation, public acceptance, local-context fit, stakeholder-value structure; each item with evidence level and source."
    },
    "config/requirements_coverage.csv": {
      "producer": "team",
      "status": "implemented",
      "consumers": [
        "validation",
        "README"
      ],
      "key": [
        "req_id"
      ],
      "description": "Every official challenge requirement mapped to pipeline stage, output and frontend page."
    },
    "model_a/a_validation.csv": {
      "producer": "A",
      "status": "implemented",
      "consumers": [
        "README / judges"
      ],
      "key": [
        "test_id"
      ],
      "description": "Calibration against the Con Ed pilot and internal consistency tests."
    },
    "model_b/b_kpis.csv": {
      "producer": "B",
      "status": "planned",
      "consumers": [
        "C"
      ],
      "key": [
        "run_id",
        "kpi_id"
      ],
      "description": "Raw values of all 16 KPIs (T* copied from A; C*, N*, S* computed) with unit and dimension."
    },
    "model_b/b_building_bills.csv": {
      "producer": "B",
      "status": "planned",
      "consumers": [
        "C (H6)",
        "frontend page 3"
      ],
      "key": [
        "run_id",
        "property_id"
      ],
      "description": "Baseline vs network heating cost per building and per apartment."
    },
    "model_b/b_stakeholder_value.csv": {
      "producer": "B",
      "status": "planned",
      "consumers": [
        "C (evaluation report)",
        "frontend page 3"
      ],
      "key": [
        "run_id",
        "stakeholder",
        "item"
      ],
      "description": "Separate value per stakeholder. data_center: heat revenue (A06 x Q_DC_used) - added electricity (E_src x A07) - O&M + own steam/gas displaced (S1). heat_users: baseline cost - (tariff x heat + connection) per building and per apartment; continuity (Q_unserved = 0). community: tCO2e avoided, kg NOx avoided, low-income households served, winter peak change."
    },
    "model_b/b_delivery_assessment.csv": {
      "producer": "B",
      "status": "planned",
      "consumers": [
        "C (evaluation report)",
        "frontend page 3"
      ],
      "key": [
        "run_id",
        "item_id"
      ],
      "description": "delivery_governance.csv items applicable to each scenario, joined to the quantitative values they reference (unscored)."
    },
    "model_b/b_constraints.csv": {
      "producer": "B",
      "status": "planned",
      "consumers": [
        "C"
      ],
      "key": [
        "run_id",
        "constraint_id"
      ],
      "description": "H6 affordability result."
    },
    "model_c/c_feasibility.csv": {
      "producer": "C",
      "status": "planned",
      "consumers": [
        "frontend"
      ],
      "key": [
        "run_id"
      ],
      "description": "All H1-H7 joined; feasible = all pass."
    },
    "model_c/c_normalized.csv": {
      "producer": "C",
      "status": "planned",
      "consumers": [
        "frontend"
      ],
      "key": [
        "run_id",
        "kpi_id"
      ],
      "description": "Baseline-referenced score s_k = clip((x - x_S0)/(target - x_S0), 0, 1)."
    },
    "model_c/c_offtaker_scores.csv": {
      "producer": "C (screening)",
      "status": "planned",
      "consumers": [
        "frontend page 1"
      ],
      "key": [
        "property_id"
      ],
      "description": "Offtaker suitability ranking (demand, distance, temperature compatibility, baseline carbon, equity, timing)."
    },
    "model_c/c_evaluation_report.json": {
      "producer": "C",
      "status": "planned",
      "consumers": [
        "frontend page 3",
        "slides"
      ],
      "key": [
        "scenario"
      ],
      "description": "Per scenario: feasibility (H1-H7), KPIs by all four dimensions, composite (only if all four present), stakeholder value split, operating-mode results, and the unscored governance panels with evidence levels."
    },
    "model_c/c_composite.csv": {
      "producer": "C",
      "status": "planned",
      "consumers": [
        "frontend page 3"
      ],
      "key": [
        "run_id",
        "weight_set"
      ],
      "description": "Composite over ALL FOUR dimensions for feasible runs only."
    },
    "model_c/c_sensitivity.csv": {
      "producer": "C",
      "status": "planned",
      "consumers": [
        "frontend page 3"
      ],
      "key": [
        "scenario",
        "test"
      ],
      "description": "Low/High tornado and Dirichlet weight rank stability."
    }
  },
  "governance_aspects": [
    "revenue_connection_model",
    "ownership",
    "responsibilities",
    "risk_allocation",
    "public_acceptance",
    "local_context_fit",
    "stakeholder_value"
  ],
  "stakeholders": [
    "data_center",
    "heat_users",
    "community"
  ],
  "requirements_coverage": "model/config/requirements_coverage.csv"
}